# Copy to .env and fill in your own values. .env is git-ignored - never commit real ids or credentials.

# Region for every AWS call
AWS_REGION=us-east-1

# MCP endpoint of your AgentCore Gateway (ends in /mcp). Unset => order and refund tools are unavailable.
GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp

# Bedrock knowledge base used for policy / product answers. Unset => the tool explains it is not configured.
KNOWLEDGE_BASE_ID=

# AgentCore Memory resource for cross-session memory. Unset => memory is skipped.
MEMORY_ID=

# Bedrock model or inference-profile id
MODEL_ID=global.amazon.nova-2-lite-v1:0

# Seconds before an idle AgentCore Browser session is reclaimed (backstop for the per-request cleanup)
BROWSER_SESSION_TIMEOUT=300

# Set to 1 to include (truncated) tool arguments in tool-call trace logs. Off by default: arguments can contain customer data.
TRACE_TOOL_INPUTS=0
